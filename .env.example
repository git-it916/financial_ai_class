# Copy to .env and fill in. Never commit .env.

# Bank of Korea ECOS  https://ecos.bok.or.kr/api  (login -> OPEN API 인증키 신청)
ECOS_API_KEY=

# KRX Open API  https://openapi.krx.co.kr  (signup -> 인증키 신청 -> '선물 일별매매정보' 서비스 이용 신청/승인)
KRX_API_KEY=

# Naver Developers  https://developers.naver.com/apps/#/register  (application -> 검색 API)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional: FRED API (only needed for release-date calendars; series use the keyless CSV)
FRED_API_KEY=

# Optional: where large files (DTCC zips, KRX raw) are stored. Default: data/external
# (gitignored, synced by OneDrive so another PC can resume).
# EXTERNAL_DATA_DIR=
